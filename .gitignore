# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Local configuration. SignalTrail needs no secrets, but a local .env is the
# usual place one would end up, so it never gets committed by accident.
.env
.env.*

# Test and tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Generated data.
# The raw telemetry and the DuckDB file are both rebuilt by
# `python run_pipeline.py --regenerate`, so neither belongs in version
# control. Clone, run the pipeline, and you get the identical dataset - the
# generator is seeded.
data/raw/*.json
data/processed/
*.duckdb
*.duckdb.wal
*.parquet

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
